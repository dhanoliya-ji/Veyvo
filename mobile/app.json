{
  "expo": {
    "name": "Veyvo",
    "slug": "veyvo",
    "scheme": "veyvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#10111A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.veyvo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Veyvo uses your microphone so you can talk in voice hangouts. You can mute anytime.",
        "NSCameraUsageDescription": "Veyvo uses your camera for profile photos, selfie verification and video hangouts. Your camera is always off until you turn it on.",
        "NSPhotoLibraryUsageDescription": "Veyvo lets you choose photos for your profile."
      },
      "bitcode": false
    },
    "android": {
      "package": "app.veyvo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#10111A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6FB",
          "dark": {
            "backgroundColor": "#10111A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9385FF"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Veyvo uses your camera for selfie verification and video hangouts. It is only on when you turn it on.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Veyvo lets you choose photos for your profile.",
          "cameraPermission": "Veyvo uses your camera so you can take a profile photo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Veyvo uses your microphone for voice chat, calls and voice notes. It's only on when you use those."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "688986e5-4c0c-4f33-8d56-174ea0ad5948"
      }
    },
    "owner": "gajendra01"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "android_sdk": "classic"
  }
}
