# Copy to backend/.env and fill in. Never commit the real .env.

# development | test | production
APP_ENV=development
# Public URL of this API (used for links). Must be https in production.
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL (asyncpg driver). Leave the SQLite default for quick local hacking.
# DATABASE_URL=postgresql+asyncpg://veyvo:veyvo@localhost:5432/veyvo
DATABASE_URL=sqlite+aiosqlite:///./veyvo_dev.db

# Redis for presence, rate limits and cross-instance realtime. Required in production.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Comma-separated browser origins allowed by CORS (not needed for the mobile app).
CORS_ORIGINS=

# In development, verification/reset codes are returned in API responses and logged.
DEV_EXPOSE_CODES=true

# Email delivery via Resend (https://resend.com). Leave empty in development.
RESEND_API_KEY=
EMAIL_FROM=Veyvo <no-reply@yourdomain.com>

# LiveKit voice (https://livekit.io). Leave empty to run without voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional Expo push security token (Expo dashboard -> Access tokens).
EXPO_PUSH_ACCESS_TOKEN=

MAX_ROOM_CAPACITY=50
MAX_MESSAGE_LENGTH=2000
PLUS_ROOM_CAPACITY=100

# ---- Photos & media storage ----
# local = files under MEDIA_DIR (development only). s3 = private S3-compatible bucket (required in production).
STORAGE_BACKEND=local
MEDIA_DIR=./media
# Cloudflare R2 example: S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
MAX_PHOTOS=6

# ---- Image moderation (photos, selfies, live video snapshots) ----
# none = auto-approve (development only). sightengine = https://sightengine.com
MODERATION_PROVIDER=none
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Automatic live-video checks in public rooms. Needs LiveKit + STORAGE_BACKEND=s3 + a moderation provider,
# and the LiveKit webhook pointed at https://<api-host>/api/v1/rooms/livekit-webhook
LIVE_VIDEO_MODERATION=false
LIVE_VIDEO_SNAPSHOT_SECONDS=10

# ---- Rewarded ads (AdMob) ----
ADMOB_ENABLED=false
AD_REWARD_GEMS=20
AD_DAILY_REWARD_CAP=5

# ---- Google Play Billing ----
GOOGLE_PLAY_PACKAGE=app.veyvo
# Path to the service-account key file, or the JSON itself
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_RTDN_TOKEN=

# ---- Error reporting (Sentry, optional) ----
# When set, server errors and the app's anonymous crash reports (POST /api/v1/client-errors) are sent to Sentry.
# Personal data is never sent: no user ids, emails, IPs, cookies, Authorization headers or request bodies.
SENTRY_DSN=
# Share of requests traced for performance monitoring, 0.0-1.0 (0 = off).
SENTRY_TRACES_SAMPLE_RATE=0.0
